# 大模型（阿里云百炼，和 pitchasso 同一把 key）
ALIYUN_BAILIAN_API_KEY=sk-xxx
# 语音合成 + 语音输入，不填就退回上面那把百炼 key
# DASHSCOPE_API_KEY=sk-xxx

# 生图（火山引擎方舟 Seedream，见 config/llm_api.yaml 的 ark 段）
# 也认 ARK_VOLCENGINE_API_KEY / VOLCENGINE_API_KEY 这两个别名
ARK_API_KEY=

# Cloudflare Tunnel（变量名带 UHWOO，避免和本机其它项目的隧道 token 撞名）：Zero Trust → Networks → Tunnels → Create a tunnel → cloudflared，
# 名字填 uhwoo，复制它给的 token；再加 Public Hostname：
#   uhwoo.com      → HTTP → localhost:8130
#   www.uhwoo.com  → HTTP → localhost:8130
CLOUDFLARED_TUNNEL_UHWOO_TOKEN=eyJ...
